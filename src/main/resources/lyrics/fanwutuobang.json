  "timeline": [
    { "id": "l1", "type": "lyric", "start_ms": 15900, "end_ms": 17820, "text": "反乌托邦中的争夺" },
    { "id": "l2", "type": "lyric", "start_ms": 17820, "end_ms": 19710, "text": "把愿望敲碎成粉末" },
    { "id": "l3", "type": "lyric", "start_ms": 19710, "end_ms": 21840, "text": "心灵也被挂上门锁" },
    { "id": "l4", "type": "lyric", "start_ms": 21840, "end_ms": 23940, "text": "看不清灯火" },
    { "id": "l5", "type": "lyric", "start_ms": 23940, "end_ms": 25770, "text": "但我还想做些什么" },
    { "id": "l6", "type": "lyric", "start_ms": 25770, "end_ms": 27780, "text": "其实还想要说很多" },
    { "id": "l7", "type": "lyric", "start_ms": 27780, "end_ms": 29730, "text": "请你等等我" },
    { "id": "l8", "type": "lyric", "start_ms": 29730, "end_ms": 31920, "text": "请你等等我" },
    { "id": "l9", "type": "lyric", "start_ms": 31920, "end_ms": 33930, "text": "两块五的签字笔" },
    { "id": "l10", "type": "lyric", "start_ms": 33930, "end_ms": 35880, "text": "东拼西凑的词句" },
    { "id": "l11", "type": "lyric", "start_ms": 35880, "end_ms": 37800, "text": "妄想用它拯救你" },
    { "id": "l12", "type": "lyric", "start_ms": 37800, "end_ms": 39360, "text": "顺便拯救我自己" },
    { "id": "l13", "type": "lyric", "start_ms": 39360, "end_ms": 39990, "text": "只因为" },
    { "id": "l14", "type": "lyric", "start_ms": 39990, "end_ms": 41940, "text": "你那渴望自由的心脏" },
    { "id": "l15", "type": "lyric", "start_ms": 41940, "end_ms": 43920, "text": "困在一张没空隙的网" },
    { "id": "l16", "type": "lyric", "start_ms": 43920, "end_ms": 45930, "text": "我们的周围并非没光亮" },
    { "id": "l17", "type": "lyric", "start_ms": 45930, "end_ms": 47940, "text": "只是太耀眼将我们灼伤" },
    { "id": "l18", "type": "lyric", "start_ms": 47940, "end_ms": 49950, "text": "在这个世界难免会迷茫" },
    { "id": "l19", "type": "lyric", "start_ms": 49950, "end_ms": 51930, "text": "但别再把小刀带在身上" },
    { "id": "l20", "type": "lyric", "start_ms": 51930, "end_ms": 53940, "text": "至少我还在为你而歌唱" },
    { "id": "l21", "type": "lyric", "start_ms": 53940, "end_ms": 58940, "text": "在黑暗漫长的反乌托邦" },
    { "id": "l22", "type": "lyric", "start_ms": 61650, "end_ms": 68650, "text": "即便我们都在这黑暗漫长的反乌托邦" },
    { "id": "l23", "type": "lyric", "start_ms": 71970, "end_ms": 73830, "text": "忍着想要挣脱的生活" },
    { "id": "l24", "type": "lyric", "start_ms": 73830, "end_ms": 75870, "text": "做出不想做的承诺" },
    { "id": "l25", "type": "lyric", "start_ms": 75870, "end_ms": 77850, "text": "列车上坐错站的乘客" },
    { "id": "l26", "type": "lyric", "start_ms": 77850, "end_ms": 79980, "text": "困惑着沉默" },
    { "id": "l27", "type": "lyric", "start_ms": 79980, "end_ms": 81780, "text": "但我还想做些什么" },
    { "id": "l28", "type": "lyric", "start_ms": 81780, "end_ms": 83790, "text": "其实还想要说很多" },
    { "id": "l29", "type": "lyric", "start_ms": 83790, "end_ms": 85740, "text": "请你等等我" },
    { "id": "l30", "type": "lyric", "start_ms": 85740, "end_ms": 87930, "text": "请你等等我" },
    { "id": "l31", "type": "lyric", "start_ms": 87930, "end_ms": 89850, "text": "发着光的半平米" },
    { "id": "l32", "type": "lyric", "start_ms": 89850, "end_ms": 91890, "text": "胡乱哼唱的旋律" },
    { "id": "l33", "type": "lyric", "start_ms": 91890, "end_ms": 93840, "text": "但是还想拯救你" },
    { "id": "l34", "type": "lyric", "start_ms": 93840, "end_ms": 95490, "text": "同时拯救我自己" },
    { "id": "l35", "type": "lyric", "start_ms": 95490, "end_ms": 95970, "text": "就请你" },
    { "id": "l36", "type": "lyric", "start_ms": 95970, "end_ms": 97920, "text": "放心大胆更妄为肆意" },
    { "id": "l37", "type": "lyric", "start_ms": 97920, "end_ms": 99900, "text": "迈步向前别害怕失去" },
    { "id": "l38", "type": "lyric", "start_ms": 99900, "end_ms": 101910, "text": "没有犯下任何错的你" },
    { "id": "l39", "type": "lyric", "start_ms": 101910, "end_ms": 103920, "text": "在我心里只用做自己" },
    { "id": "l40", "type": "lyric", "start_ms": 103920, "end_ms": 105930, "text": "这段胡乱拼凑的词语" },
    { "id": "l41", "type": "lyric", "start_ms": 105930, "end_ms": 107940, "text": "如果伤到你也请你忘记" },
    { "id": "l42", "type": "lyric", "start_ms": 107940, "end_ms": 109890, "text": "但若你又找不到意义" },
    { "id": "l43", "type": "lyric", "start_ms": 109890, "end_ms": 113880, "text": "希望这首歌能被记起" },
    { "id": "l44", "type": "lyric", "start_ms": 113880, "end_ms": 115380, "text": "活下去" },
    { "id": "l45", "type": "lyric", "start_ms": 117900, "end_ms": 119400, "text": "活下去" },
    { "id": "l46", "type": "lyric", "start_ms": 121890, "end_ms": 123390, "text": "活下去" },
    { "id": "l47", "type": "lyric", "start_ms": 125820, "end_ms": 127320, "text": "活下去" },
    { "id": "l48", "type": "lyric", "start_ms": 129870, "end_ms": 134870, "text": "在这反乌托邦里" }
  ],
